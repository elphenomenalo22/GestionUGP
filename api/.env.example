DATABASE_URL=postgresql://gugp:gugp@localhost:5433/gugp
JWT_SECRET=change-me-in-production
PORT=4010
CORS_ORIGIN=http://localhost:5173

# URL publique du frontend, utilisée dans le lien de connexion des e-mails
APP_URL=http://localhost:5173

# EMAIL — Deux méthodes possibles :
# 1. API HTTP Brevo (RECOMMANDÉ SUR RENDER GRATUIT : le port HTTPS 443 n'est jamais bloqué)
# Obtenez votre clé API v3 (commence par xkeysib-...) sur https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
# Ou Resend (https://resend.com) :
# RESEND_API_KEY=re_...

# 2. Relais SMTP classique (ATTENTION : Render Free bloque les ports sortants 25, 465, 587)
# Fonctionne en local ou sur un hébergement payant sans blocage de port.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=G-UGP <no-reply@ugp-boad.tg>

# Notifications push navigateur (gestionnaires uniquement). Générez une paire
# avec : npx web-push generate-vapid-keys
# La clé publique doit aussi être copiée dans .env (racine) sous
# VITE_VAPID_PUBLIC_KEY — les deux valeurs doivent correspondre à la même paire.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@ugp-boad.tg
